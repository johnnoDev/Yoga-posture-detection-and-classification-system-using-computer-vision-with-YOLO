# Plantilla de variables de entorno.
# Copia este archivo a  .env  (mismo directorio) y rellena el valor real.
# El .env NO se sube a git (esta en .gitignore); este .env.example si.
#
#   Windows PowerShell:  Copy-Item .env.example .env
#   Windows cmd:         copy .env.example .env

# API key privada de Roboflow -> https://app.roboflow.com -> Settings -> API Keys
ROBOFLOW_API_KEY=
